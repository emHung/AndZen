<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeWidth="0dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_rating_badge"
                    android:backgroundTint="@color/brand_100"/>
                <ImageView
                    android:id="@+id/formPitchHeaderIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ri_football"
                    app:tint="@color/primary_green"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/formPitchTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_dialog_admin_pitch_form_formpitchtitle_text_9543a6"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <TextView
                    android:id="@+id/formPitchSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_dialog_admin_pitch_form_formpitchsubtitle_text_05c93b"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/formPitchClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_ri_delete_bin"
                app:tint="@color/text_muted"
                android:visibility="gone"
                android:contentDescription="@string/ui_action_formpitchclose_9ed068"
                android:focusable="true"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border"/>
        <!-- Scrollable Content -->
        <ScrollView
            android:id="@+id/formPitchScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadeScrollbars="false"
            android:overScrollMode="never">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="12dp">
                <!-- Section: Ảnh sân bóng -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_dialog_admin_pitch_form_textview_text_71f942"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_green"
                    android:letterSpacing="0.06"/>
                <!-- Image Preview Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border"
                    app:cardBackgroundColor="#F8FAF9">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:id="@+id/formPitchImagePreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_pitch_1"
                            android:importantForAccessibility="no"/>
                        <!-- Placeholder view when no image or default -->
                        <LinearLayout
                            android:id="@+id/formPitchImagePlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#66000000"
                            android:visibility="gone">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_ri_image"
                                app:tint="@color/white"
                                android:importantForAccessibility="no"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/ui_dialog_admin_pitch_form_textview_text_0806af"
                                android:textColor="@color/white"
                                android:textSize="12sp"/>
                        </LinearLayout>
                        <!-- Badge image status -->
                        <TextView
                            android:id="@+id/formPitchImageStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="10dp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:background="@drawable/bg_tag_light_green"
                            android:text="@string/ui_dialog_admin_pitch_form_formpitchimagestatusbadge_text_c88e8f"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_green"/>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
                <!-- Button Choose Image from Device -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickImageDevice"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/ui_dialog_admin_pitch_form_btnpickimagedevice_text_dcd2e0"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_green"
                    app:backgroundTint="@color/brand_100"
                    app:cornerRadius="12dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/primary_green"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
                <!-- Presets selection row -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/ui_dialog_admin_pitch_form_textview_text_d747b7"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"/>
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/chipPreset1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_chip_selected_pill"
                            android:text="@string/ui_dialog_admin_pitch_form_chippreset1_text_f09a06"
                            android:textSize="12sp"
                            android:textColor="@color/white"/>
                        <TextView
                            android:id="@+id/chipPreset2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_input_field"
                            android:text="@string/ui_dialog_admin_pitch_form_chippreset2_text_a1e137"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"/>
                        <TextView
                            android:id="@+id/chipPresetSunset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_input_field"
                            android:text="@string/ui_dialog_admin_pitch_form_chippresetsunset_text_af2f3a"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"/>
                        <TextView
                            android:id="@+id/chipPresetNight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:background="@drawable/bg_input_field"
                            android:text="@string/ui_dialog_admin_pitch_form_chippresetnight_text_dffa79"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"/>
                    </LinearLayout>
                </HorizontalScrollView>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/border"/>
                <!-- Section: Thông tin cơ bản -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/ui_dialog_admin_pitch_form_textview_text_60c068"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_green"
                    android:letterSpacing="0.06"/>
                <!-- Mã sân -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/ui_dialog_admin_pitch_form_textview_text_de5b6c"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <EditText
                    android:id="@+id/formPitchId"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/ui_dialog_admin_pitch_form_formpitchid_hint_61b76c"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:singleLine="true"
                    android:inputType="text"
                    android:importantForAutofill="no"/>
                <!-- Tên sân -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/ui_dialog_admin_pitch_form_textview_text_5e86a4"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <EditText
                    android:id="@+id/formPitchName"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/ui_dialog_admin_pitch_form_formpitchname_hint_f449d2"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:singleLine="true"
                    android:inputType="textCapWords"
                    android:importantForAutofill="no"/>
                <!-- Loại sân & Giá cơ bản (2 cột) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_dialog_admin_pitch_form_textview_text_c32d7a"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"/>
                        <Spinner
                            android:id="@+id/formPitchTypeSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="4dp"
                            android:paddingHorizontal="8dp"
                            android:background="@drawable/bg_input_field"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_dialog_admin_pitch_form_textview_text_bcc087"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"/>
                        <EditText
                            android:id="@+id/formPitchPrice"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="4dp"
                            android:paddingHorizontal="14dp"
                            android:background="@drawable/bg_input_field"
                            android:hint="@string/ui_dialog_admin_pitch_form_formpitchprice_hint_1c4d5b"
                            android:inputType="number"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:singleLine="true"
                            android:importantForAutofill="no"/>
                    </LinearLayout>
                </LinearLayout>
                <!-- Khu vực -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/ui_dialog_admin_pitch_form_textview_text_fdf8bd"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <EditText
                    android:id="@+id/formPitchDistrict"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/ui_dialog_admin_pitch_form_formpitchdistrict_hint_68ed3f"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:singleLine="true"
                    android:inputType="textCapWords"
                    android:importantForAutofill="no"/>
                <!-- Địa chỉ chi tiết -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/ui_dialog_admin_pitch_form_textview_text_025ae4"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <EditText
                    android:id="@+id/formPitchAddress"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/ui_dialog_admin_pitch_form_formpitchaddress_hint_3426d6"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:singleLine="true"
                    android:inputType="textPostalAddress"
                    android:importantForAutofill="no"/>
                <!-- Tiện ích -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/ui_dialog_admin_pitch_form_textview_text_623010"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <EditText
                    android:id="@+id/formPitchAmenities"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/ui_dialog_admin_pitch_form_formpitchamenities_hint_fd8d0a"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:singleLine="true"
                    android:inputType="text"
                    android:importantForAutofill="no"/>
                <!-- Gợi ý tiện ích nhanh -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tagAmenityLed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_tag_light_green"
                            android:text="@string/ui_dialog_admin_pitch_form_tagamenityled_text_8a110b"
                            android:textSize="11sp"
                            android:textColor="@color/primary_green"/>
                        <TextView
                            android:id="@+id/tagAmenityWater"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_tag_light_green"
                            android:text="@string/ui_dialog_admin_pitch_form_tagamenitywater_text_eb1259"
                            android:textSize="11sp"
                            android:textColor="@color/primary_green"/>
                        <TextView
                            android:id="@+id/tagAmenityParking"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_tag_light_green"
                            android:text="@string/ui_dialog_admin_pitch_form_tagamenityparking_text_8a982f"
                            android:textSize="11sp"
                            android:textColor="@color/primary_green"/>
                        <TextView
                            android:id="@+id/tagAmenityBib"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_tag_light_green"
                            android:text="@string/ui_dialog_admin_pitch_form_tagamenitybib_text_f50306"
                            android:textSize="11sp"
                            android:textColor="@color/primary_green"/>
                        <TextView
                            android:id="@+id/tagAmenityShower"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:background="@drawable/bg_tag_light_green"
                            android:text="@string/ui_dialog_admin_pitch_form_tagamenityshower_text_6a2a09"
                            android:textSize="11sp"
                            android:textColor="@color/primary_green"/>
                    </LinearLayout>
                </HorizontalScrollView>
                <!-- Mô tả sân -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/ui_dialog_admin_pitch_form_textview_text_b04df0"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <EditText
                    android:id="@+id/formPitchDescription"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:gravity="top|start"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/ui_dialog_admin_pitch_form_formpitchdescription_hint_268591"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:inputType="textMultiLine|textCapSentences"
                    android:importantForAutofill="no"/>
                <!-- Trạng thái hoạt động -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/formPitchActiveSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/ui_dialog_admin_pitch_form_formpitchactiveswitch_text_8cf9f8"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    app:useMaterialThemeColors="true"/>
            </LinearLayout>
        </ScrollView>
        <!-- Thông báo lỗi (Ghim cố định phía trên các nút bấm) -->
        <TextView
            android:id="@+id/formPitchError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_tag_red_light"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:text="@string/ui_dialog_admin_pitch_form_formpitcherror_text_512d97"
            android:textSize="12sp"
            android:textColor="@color/danger"
            android:textStyle="bold"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_ri_info"
            app:drawableTint="@color/danger"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border"/>
        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp"
            android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelPitchForm"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/ui_dialog_admin_pitch_form_btncancelpitchform_text_34ca76"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                app:backgroundTint="#F1F5F9"
                app:cornerRadius="12dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSavePitchForm"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.6"
                android:layout_marginStart="8dp"
                android:text="@string/ui_dialog_admin_pitch_form_btnsavepitchform_text_b49d87"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/primary_green"
                app:cornerRadius="12dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
