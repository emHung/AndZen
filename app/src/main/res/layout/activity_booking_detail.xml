<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_green"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_ri_arrow_left"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/white"
            android:contentDescription="@string/ui_action_btnback_8a09e0"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="@string/ui_activity_booking_detail_textview_text_fe5e0d"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"/>
        <ImageView
            android:id="@+id/btnMenuMore"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_ri_more"
            app:tint="@color/white"
            android:contentDescription="@string/ui_action_btnmenumore_50e678"
            android:focusable="true"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <!-- Pitch Image Card with Overlay Badges -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/ivDetailPitchImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_pitch_sunset"
                        android:importantForAccessibility="no"/>
                    <!-- Top-right status badge -->
                    <TextView
                        android:id="@+id/tvBadgeStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_activity_booking_detail_tvbadgestatus_text_674870"
                        android:textColor="@color/primary_green"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_ri_check_14x14"
                        app:drawableTint="@color/primary_green"
                        android:drawablePadding="4dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="12dp"
                        android:gravity="center_vertical"/>
                    <!-- Bottom-right photo count -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvDetailPhotoCount"
                        android:text=""
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        app:drawableStartCompat="@drawable/ic_ri_image_14x14"
                        app:drawableTint="@color/white"
                        android:drawablePadding="4dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="12dp"
                        android:gravity="center_vertical"/>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Pitch Title & Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#ECEFF1"
                app:cardBackgroundColor="@color/surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvDetailPitchName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=""
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"/>
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_ri_star"
                            app:tint="#F59E0B"
                            android:importantForAccessibility="no"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/ui_activity_booking_detail_textview_text_ff107d"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvDetailPitchAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:drawableStartCompat="@drawable/ic_ri_map_pin_14x14"
                        app:drawableTint="@color/text_muted"
                        android:drawablePadding="4dp"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"/>
                    <!-- Amenities row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/tvDetailPitchType"
                            android:text=""
                            android:textColor="@color/primary_green"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/ic_ri_football_13x13"
                            app:drawableTint="@color/primary_green"
                            android:drawablePadding="4dp"
                            android:gravity="center_vertical"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/tvDetailAmenityOne"
                            android:text=""
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            app:drawableStartCompat="@drawable/ic_ri_lightbulb_13x13"
                            app:drawableTint="@color/text_secondary"
                            android:drawablePadding="4dp"
                            android:layout_marginStart="8dp"
                            android:gravity="center_vertical"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/tvDetailAmenityTwo"
                            android:text=""
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            app:drawableStartCompat="@drawable/ic_ri_car_13x13"
                            app:drawableTint="@color/text_secondary"
                            android:drawablePadding="4dp"
                            android:layout_marginStart="8dp"
                            android:gravity="center_vertical"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Booking Code Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#ECEFF1"
                app:cardBackgroundColor="@color/surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_activity_booking_detail_textview_text_2d2c19"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"/>
                        <TextView
                            android:id="@+id/tvDetailBookingCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_activity_booking_detail_tvdetailbookingcode_text_2e77be"
                            android:textColor="@color/primary_green"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:drawableEndCompat="@drawable/ic_ri_copy_20x20"
                            app:drawableTint="@color/text_muted"
                            android:drawablePadding="8dp"
                            android:contentDescription="@string/ui_action_btncopybookingcode_cacda0"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginTop="2dp"
                            android:gravity="center_vertical"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvDetailStatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag_light_green"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="@string/ui_activity_booking_detail_tvdetailstatuspill_text_aeabb2"
                        android:textColor="@color/primary_green"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Booking Time Card (3 columns) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#ECEFF1"
                app:cardBackgroundColor="@color/surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_activity_booking_detail_textview_text_2fbc49"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                        <!-- Col 1 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_ri_calendar"
                                app:tint="@color/primary_green"
                                android:importantForAccessibility="no"/>
                            <TextView
                                android:id="@+id/tvDetailDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/ui_activity_booking_detail_tvdetaildate_text_c073f1"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_activity_booking_detail_textview_text_e8ef7e"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp"/>
                        </LinearLayout>
                        <!-- Col 2 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_ri_time"
                                app:tint="@color/primary_green"
                                android:importantForAccessibility="no"/>
                            <TextView
                                android:id="@+id/tvDetailTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/ui_activity_booking_detail_tvdetailtime_text_df1fc4"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_activity_booking_detail_textview_text_fe399e"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp"/>
                        </LinearLayout>
                        <!-- Col 3 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_ri_hourglass"
                                app:tint="@color/primary_green"
                                android:importantForAccessibility="no"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:id="@+id/tvDetailDuration"
                                android:text=""
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_activity_booking_detail_textview_text_b7629c"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Pricing Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#ECEFF1"
                app:cardBackgroundColor="@color/surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_activity_booking_detail_textview_text_fc6133"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ui_activity_booking_detail_textview_text_acd73d"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"/>
                        <TextView
                            android:id="@+id/tvDetailPitchPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ui_activity_booking_detail_textview_text_8ecfc8"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_activity_booking_detail_textview_text_39c1df"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"/>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="#EEEEEE"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ui_activity_booking_detail_textview_text_43f8d6"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/tvDetailTotalPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/primary_green"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Customer Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#ECEFF1"
                app:cardBackgroundColor="@color/surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_activity_booking_detail_textview_text_282999"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical">
                        <!-- Avatar -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_ri_user_fill"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                            android:importantForAccessibility="no"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvDetailCustomerName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:id="@+id/tvDetailCustomerPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"/>
                        </LinearLayout>
                        <!-- Call button -->
                        <FrameLayout
                            android:id="@+id/btnCallCustomer"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_tag_light_green">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_ri_phone"
                                app:tint="@color/primary_green"
                                android:importantForAccessibility="no"/>
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Important Notice Banner -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_activity_booking_detail_textview_text_dc554b"
                android:textColor="@color/primary_green"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_ri_info_18x18"
                app:drawableTint="@color/primary_green"
                android:drawablePadding="8dp"
                android:layout_marginTop="12dp"
                android:padding="12dp"
                android:gravity="center_vertical"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="16dp"/>
        </LinearLayout>
    </ScrollView>
    <!-- Bottom Action Bar (Đổi giờ sân, Liên hệ sân & Hủy đặt) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:padding="16dp"
        android:elevation="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRescheduleSlot"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/primary_green"
            android:text="@string/ui_activity_booking_detail_btnrescheduleslot_text_ce2412"
            android:textColor="@color/surface"
            android:textSize="14sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_ri_time"
            app:iconTint="@color/surface"
            app:cornerRadius="12dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContactPitch"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/ui_activity_booking_detail_btncontactpitch_text_603522"
                android:textColor="@color/primary_green"
                app:strokeColor="@color/primary_green"
                app:strokeWidth="1.5dp"
                app:icon="@drawable/ic_ri_phone"
                app:iconTint="@color/primary_green"
                app:cornerRadius="12dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelDetail"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/ui_activity_booking_detail_btncanceldetail_text_e6796a"
                android:textColor="#E53935"
                app:strokeColor="#FFCDD2"
                app:strokeWidth="1.5dp"
                app:icon="@drawable/ic_ri_delete_bin"
                app:iconTint="#E53935"
                app:cornerRadius="12dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
