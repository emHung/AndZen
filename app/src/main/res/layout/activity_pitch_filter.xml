<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <!-- Header Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarFilter"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_green"
        app:navigationIcon="@drawable/ic_ri_arrow_left"
        app:navigationIconTint="@color/surface"
        app:title="Bộ lọc tìm sân"
        app:titleTextColor="@color/surface">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_activity_pitch_filter_textview_text_38f5bb"
            android:textColor="@color/surface"
            android:textSize="14sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_ri_restart_16x16"
            app:drawableTint="@color/surface"
            android:drawablePadding="4dp"
            android:id="@+id/btnResetFilter"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"/>
    </com.google.android.material.appbar.MaterialToolbar>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Banner Image -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_pitch_1"
                android:importantForAccessibility="no"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <!-- Card 1: Khu vực -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#ECEFF1"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">
                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_tag_light_green">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_ri_map_pin"
                                    app:tint="@color/primary_green"
                                    android:importantForAccessibility="no"/>
                            </FrameLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/ui_activity_pitch_filter_textview_text_c12e4b"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/btnFilterDistrict"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="@string/ui_activity_pitch_filter_tvfilterdistrict_text_443f1c"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:drawableEndCompat="@drawable/ic_ri_arrow_down_18x18"
                            app:drawableTint="@color/text_muted"
                            android:drawablePadding="0dp"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_input_field"
                            android:paddingHorizontal="14dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <!-- Card 2: Ngày chơi -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#ECEFF1"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">
                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_tag_light_green">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_ri_calendar"
                                    app:tint="@color/primary_green"
                                    android:importantForAccessibility="no"/>
                            </FrameLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/ui_activity_pitch_filter_textview_text_ed61b0"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/btnFilterDate"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="@string/ui_activity_pitch_filter_tvfilterdate_text_d53364"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:drawableEndCompat="@drawable/ic_ri_arrow_down_18x18"
                            app:drawableTint="@color/text_muted"
                            android:drawablePadding="0dp"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_input_field"
                            android:paddingHorizontal="14dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <!-- Card 3: Loại sân -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#ECEFF1"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">
                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_tag_light_green">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_ri_football"
                                    app:tint="@color/primary_green"
                                    android:importantForAccessibility="no"/>
                            </FrameLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/ui_activity_pitch_filter_textview_text_c32d7a"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:fillViewport="false"
                            android:scrollbars="none">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="horizontal">
                                <TextView
                                    android:id="@+id/chipType5"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginEnd="6dp"
                                    android:paddingHorizontal="12dp"
                                    android:background="@drawable/bg_input_field"
                                    android:gravity="center"
                                    android:text="@string/ui_activity_pitch_filter_chiptype5_text_04dd7e"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:id="@+id/chipType7"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginHorizontal="3dp"
                                    android:paddingHorizontal="12dp"
                                    android:background="@drawable/bg_btn_primary"
                                    android:gravity="center"
                                    android:text="@string/ui_activity_pitch_filter_chiptype7_text_7c86c8"
                                    android:textColor="@color/surface"
                                    android:textSize="13sp"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:id="@+id/chipType11"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginStart="6dp"
                                    android:paddingHorizontal="12dp"
                                    android:background="@drawable/bg_input_field"
                                    android:gravity="center"
                                    android:text="@string/ui_activity_pitch_filter_chiptype11_text_b8f71e"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                        </HorizontalScrollView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <!-- Card 4: Khoảng giá / trận -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#ECEFF1"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">
                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_tag_light_green">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_ri_coins"
                                    app:tint="@color/primary_green"
                                    android:importantForAccessibility="no"/>
                            </FrameLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/ui_activity_pitch_filter_textview_text_0d5e7a"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp">
                            <TextView
                                android:id="@+id/tvMinPrice"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/ui_activity_pitch_filter_tvminprice_text_9d196f"
                                android:textColor="@color/primary_green"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:id="@+id/tvMaxPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_activity_pitch_filter_tvmaxprice_text_bf8bea"
                                android:textColor="@color/primary_green"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <SeekBar
                            android:id="@+id/seekBarPrice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:max="1000"
                            android:progress="600"
                            android:progressTint="@color/primary_green"
                            android:thumbTint="@color/primary_green"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <!-- Card 5: Tiện ích -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#ECEFF1"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">
                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_tag_light_green">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_ri_settings"
                                    app:tint="@color/primary_green"
                                    android:importantForAccessibility="no"/>
                            </FrameLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/ui_activity_pitch_filter_textview_text_48403e"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <!-- 2 Rows of Checkboxes -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">
                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbLed"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_tag_light_green"
                                android:button="@drawable/sl_ri_checkbox"
                                app:buttonTint="@null"
                                android:checked="true"
                                android:drawablePadding="6dp"
                                android:paddingStart="6dp"
                                android:paddingEnd="12dp"
                                android:text="@string/ui_activity_pitch_filter_cbled_text_34811d"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                app:drawableEndCompat="@drawable/ic_ri_lightbulb"
                                app:drawableTint="@color/text_secondary"/>
                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbParking"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_input_field"
                                android:button="@drawable/sl_ri_checkbox"
                                app:buttonTint="@null"
                                android:drawablePadding="6dp"
                                android:paddingStart="6dp"
                                android:paddingEnd="12dp"
                                android:text="@string/ui_activity_pitch_filter_cbparking_text_045fe3"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                app:drawableEndCompat="@drawable/ic_ri_car"
                                app:drawableTint="@color/text_secondary"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">
                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbWater"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_input_field"
                                android:button="@drawable/sl_ri_checkbox"
                                app:buttonTint="@null"
                                android:drawablePadding="6dp"
                                android:paddingStart="6dp"
                                android:paddingEnd="12dp"
                                android:text="@string/ui_activity_pitch_filter_cbwater_text_a570bb"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                app:drawableEndCompat="@drawable/ic_ri_drop"
                                app:drawableTint="@color/text_secondary"/>
                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbShoes"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_input_field"
                                android:button="@drawable/sl_ri_checkbox"
                                app:buttonTint="@null"
                                android:drawablePadding="6dp"
                                android:paddingStart="6dp"
                                android:paddingEnd="12dp"
                                android:text="@string/ui_activity_pitch_filter_cbshoes_text_f53d52"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                app:drawableEndCompat="@drawable/ic_ri_shirt"
                                app:drawableTint="@color/text_secondary"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <!-- Card 6: Khung giờ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#ECEFF1"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">
                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_tag_light_green">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_ri_time"
                                    app:tint="@color/primary_green"
                                    android:importantForAccessibility="no"/>
                            </FrameLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/ui_activity_pitch_filter_textview_text_aff798"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:scrollbars="none">
                            <LinearLayout
                                android:id="@+id/timeChipRow"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"/>
                        </HorizontalScrollView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <!-- Bottom Bar with 2 Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearFilter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:backgroundTint="#E8F5E9"
            android:text="@string/ui_activity_pitch_filter_btnclearfilter_text_91b03f"
            android:textColor="@color/primary_green"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="#C8E6C9"
            app:strokeWidth="1dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyFilter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.6"
            android:backgroundTint="@color/primary_green"
            android:text="@string/ui_activity_pitch_filter_btnapplyfilter_text_cea0cf"
            android:textColor="@color/surface"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_ri_arrow_right"
            app:iconGravity="textEnd"
            app:iconTint="@color/surface"/>
    </LinearLayout>
</LinearLayout>
