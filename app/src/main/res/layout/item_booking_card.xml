<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border"
    app:cardBackgroundColor="@color/surface">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!-- Ảnh sân bóng -->
        <ImageView
            android:id="@+id/ivBookingBanner"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_pitch_1"
            android:importantForAccessibility="no"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <!-- Header: Mã đặt chỗ + Trạng thái badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvBookingCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_green"
                    android:text="@string/ui_item_booking_card_tvbookingcode_text_f3076e"/>
                <TextView
                    android:id="@+id/tvBookingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_type_badge"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_green"
                    android:drawablePadding="4dp"
                    app:drawableTint="@color/primary_green"
                    android:text="@string/ui_item_booking_card_tvbookingstatus_text_674870"
                    app:drawableStartCompat="@drawable/ic_ri_check_circle"/>
            </LinearLayout>
            <!-- Tên sân -->
            <TextView
                android:id="@+id/tvPitchName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text=""/>
            <!-- Địa chỉ -->
            <TextView
                android:id="@+id/tvBookingAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:text=""
                app:drawableStartCompat="@drawable/ic_ri_map_pin_14x14"
                app:drawableTint="@color/text_muted"
                android:drawablePadding="6dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"/>
            <!-- Huy hiệu loại sân -->
            <TextView
                android:id="@+id/tvBookingType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_type_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/primary_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:drawablePadding="4dp"
                app:drawableTint="@color/primary_green"
                android:text="@string/ui_item_booking_card_tvbookingtype_text_9408bf"
                app:drawableStartCompat="@drawable/ic_ri_group"/>
            <!-- Thời gian đặt: Ngày | Giờ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_ri_calendar"
                    app:tint="@color/primary_green"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:id="@+id/tvBookingDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:text="@string/ui_item_booking_card_tvbookingdate_text_c073f1"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:textColor="@color/border"
                    android:text="@string/ui_item_booking_card_textview_text_3eb416"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_ri_time"
                    app:tint="@color/primary_green"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:id="@+id/tvBookingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:text="@string/ui_item_booking_card_tvbookingtime_text_df1fc4"/>
            </LinearLayout>
            <!-- Số điện thoại người đặt -->
            <TextView
                android:id="@+id/tvCustomerInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:text="@string/ui_item_booking_card_tvcustomerinfo_text_264e88"
                app:drawableStartCompat="@drawable/ic_ri_phone_14x14"
                app:drawableTint="@color/text_muted"
                android:drawablePadding="6dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"/>
            <!-- Dòng phân cách -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/border"/>
            <!-- Footer: Tổng tiền + Nút Chi tiết + Nút Hủy -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:text="@string/ui_item_booking_card_textview_text_43f8d6"/>
                    <TextView
                        android:id="@+id/tvTotalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_green"
                        android:text=""/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetailsBooking"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="@string/ui_item_booking_card_btndetailsbooking_text_d72a63"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_ri_info"
                    app:iconSize="14dp"
                    app:iconTint="@color/text_primary"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelBooking"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/ui_item_booking_card_btncancelbooking_text_e6796a"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    android:backgroundTint="@color/danger_bg"
                    android:textColor="@color/danger"
                    app:strokeWidth="0dp"
                    app:icon="@drawable/ic_ri_delete_bin"
                    app:iconSize="14dp"
                    app:iconTint="@color/danger"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
