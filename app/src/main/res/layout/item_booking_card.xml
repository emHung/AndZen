<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Ảnh sân bóng -->
        <ImageView
            android:id="@+id/ivBookingBanner"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_pitch_1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header: Mã đặt chỗ + Trạng thái badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvBookingCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_green"
                    android:text="Mã: SB-X8U4EE" />

                <TextView
                    android:id="@+id/tvBookingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_type_badge"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_green"
                    android:drawableStart="@drawable/ic_ri_check_circle"
                    android:drawablePadding="4dp"
                    app:drawableTint="@color/primary_green"
                    android:text="Đã xác nhận" />
            </LinearLayout>

            <!-- Tên sân -->
            <TextView
                android:id="@+id/tvPitchName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="" />

            <!-- Địa chỉ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_ri_map_pin"
                    app:tint="@color/text_muted" />

                <TextView
                    android:id="@+id/tvBookingAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:text="" />
            </LinearLayout>

            <!-- Huy hiệu loại sân -->
            <TextView
                android:id="@+id/tvBookingType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_type_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/primary_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_ri_group"
                android:drawablePadding="4dp"
                app:drawableTint="@color/primary_green"
                android:text="Sân 7 người" />

            <!-- Thời gian đặt: Ngày | Giờ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_ri_calendar"
                    app:tint="@color/primary_green" />

                <TextView
                    android:id="@+id/tvBookingDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:text="Hôm nay, 14/10" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:textColor="@color/border"
                    android:text="|" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_ri_time"
                    app:tint="@color/primary_green" />

                <TextView
                    android:id="@+id/tvBookingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:text="16:30 – 18:00" />
            </LinearLayout>

            <!-- Số điện thoại người đặt -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_ri_phone"
                    app:tint="@color/text_muted" />

                <TextView
                    android:id="@+id/tvCustomerInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:text="036 241 5016" />
            </LinearLayout>

            <!-- Dòng phân cách -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/border" />

            <!-- Footer: Tổng tiền + Nút Chi tiết + Nút Hủy -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:text="Tổng thanh toán" />

                    <TextView
                        android:id="@+id/tvTotalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_green"
                        android:text="" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetailsBooking"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Chi tiết"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_ri_info"
                    app:iconSize="14dp"
                    app:iconTint="@color/text_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelBooking"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:text="Hủy đặt"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    android:backgroundTint="@color/danger_bg"
                    android:textColor="@color/danger"
                    app:strokeWidth="0dp"
                    app:icon="@drawable/ic_ri_delete_bin"
                    app:iconSize="14dp"
                    app:iconTint="@color/danger" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
