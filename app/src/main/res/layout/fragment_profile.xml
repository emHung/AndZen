<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <!-- Top Green Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_green"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:baselineAligned="false">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_fragment_profile_textview_text_4a60ab"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/ui_fragment_profile_textview_text_6336eb"
                android:textColor="#C8E6C9"
                android:textSize="13sp"/>
        </LinearLayout>
        <!-- Notification Bell -->
        <FrameLayout
            android:id="@+id/btnProfileNotification"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_header_action"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/accessibility_btn_profile_notification">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_ri_notification"
                app:tint="@color/white"
                android:importantForAccessibility="no"/>
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_red"/>
        </FrameLayout>
        <!-- Settings Cog -->
        <FrameLayout
            android:id="@+id/btnProfileSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_header_action"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/accessibility_btn_profile_settings">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_ri_settings"
                app:tint="@color/white"
                android:importantForAccessibility="no"/>
        </FrameLayout>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <!-- Profile Overview Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#ECEFF1"
                app:cardBackgroundColor="@color/surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:showDividers="middle"
                    android:divider="@drawable/profile_divider_1"
                    android:dividerPadding="0dp">
                    <!-- Avatar + Name + Edit -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdminManagement"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/ui_fragment_profile_btnadminmanagement_text_c4e74f"
                        android:visibility="gone"
                        app:icon="@drawable/ic_ri_settings"
                        app:iconGravity="textStart"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <!-- Avatar with Camera Badge -->
                        <FrameLayout
                            android:layout_width="68dp"
                            android:layout_height="68dp">
                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivProfileAvatar"
                                android:layout_width="68dp"
                                android:layout_height="68dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_ri_user_fill"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                                android:importantForAccessibility="no"/>
                            <FrameLayout
                                android:id="@+id/btnChangeAvatar"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="bottom|end"
                                android:background="@drawable/bg_avatar_camera"
                                android:contentDescription="@string/accessibility_btn_change_avatar"
                                android:focusable="true">
                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_ri_camera"
                                    app:tint="@color/white"
                                    android:importantForAccessibility="no"/>
                            </FrameLayout>
                        </FrameLayout>
                        <!-- Name and Member Badge -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvProfileName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_fragment_profile_tvprofilename_text_4a60ab"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold"/>
                            <!-- Member Pill -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_fragment_profile_textview_text_cd264c"
                                android:textColor="@color/primary_green"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                app:drawableStartCompat="@drawable/ic_ri_shield_12x12"
                                app:drawableTint="@color/primary_green"
                                android:drawablePadding="4dp"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"/>
                        </LinearLayout>
                        <!-- Edit Profile Button -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_fragment_profile_textview_text_b59e65"
                            android:textColor="@color/primary_green"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/ic_ri_edit_14x14"
                            app:drawableTint="@color/primary_green"
                            android:drawablePadding="4dp"
                            android:id="@+id/btnEditProfile"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_tag_light_green"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp"/>
                    </LinearLayout>
                    <!-- Divider -->
                    <!-- Stats 3 Columns -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:id="@+id/btnStatBookings"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvStatBookingsNum"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_fragment_profile_tvstatbookingsnum_text_1b9379"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/ui_fragment_profile_textview_text_c0cb60"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"/>
                        </LinearLayout>
                        <View
                            android:layout_width="1dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center_vertical"
                            android:background="#E0E0E0"/>
                        <LinearLayout
                            android:id="@+id/btnStatFavorites"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvStatFavoritesNum"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_fragment_profile_tvstatfavoritesnum_text_1b9379"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/ui_fragment_profile_textview_text_c2f884"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"/>
                        </LinearLayout>
                        <View
                            android:layout_width="1dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center_vertical"
                            android:background="#E0E0E0"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_fragment_profile_textview_text_1b9379"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                app:drawableEndCompat="@drawable/ic_ri_star_16x16"
                                app:drawableTint="#F59E0B"
                                android:drawablePadding="2dp"
                                android:gravity="center_vertical"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/ui_fragment_profile_textview_text_c1f220"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Sân thường đặt Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ui_fragment_profile_textview_text_23d703"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/btnViewAllFavorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_fragment_profile_btnviewallfavorite_text_fd90cb"
                    android:textColor="@color/primary_green"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>
            <!-- Frequent Pitch Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFrequentPitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#ECEFF1"
                app:cardBackgroundColor="@color/surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="100dp"
                        android:layout_height="72dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_ri_calendar"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                        android:importantForAccessibility="no"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvFrequentPitchName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_fragment_profile_tvfrequentpitchname_text_d9dfb3"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/tvFrequentPitchAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_fragment_profile_tvfrequentpitchaddress_text_91e3b2"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            app:drawableStartCompat="@drawable/ic_ri_map_pin_14x14"
                            app:drawableTint="@color/primary_green"
                            android:drawablePadding="4dp"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"/>
                        <TextView
                            android:id="@+id/tvFrequentPitchDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_fragment_profile_tvfrequentpitchdate_text_77b70c"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            app:drawableStartCompat="@drawable/ic_ri_calendar_14x14"
                            app:drawableTint="@color/text_muted"
                            android:drawablePadding="4dp"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_ri_arrow_right_s"
                        app:tint="@color/text_muted"
                        android:importantForAccessibility="no"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Thông tin cá nhân Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/ui_fragment_profile_textview_text_5de3e5"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#ECEFF1"
                app:cardBackgroundColor="@color/surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:showDividers="middle"
                    android:divider="@drawable/profile_divider_4"
                    android:dividerPadding="62dp">
                    <!-- Phone row -->
                    <LinearLayout
                        android:id="@+id/btnProfilePhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_fragment_profile_textview_text_58f523"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:drawableStartCompat="@drawable/profile_bubble_ic_ri_phone"
                            android:drawablePadding="12dp"
                            android:minHeight="36dp"
                            android:gravity="center_vertical"/>
                        <TextView
                            android:id="@+id/tvProfilePhone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text=""
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            app:drawableEndCompat="@drawable/ic_ri_arrow_right_s"
                            android:drawablePadding="8dp"/>
                    </LinearLayout>
                    <!-- Email row -->
                    <LinearLayout
                        android:id="@+id/btnProfileEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_fragment_profile_textview_text_84add5"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:drawableStartCompat="@drawable/profile_bubble_ic_ri_mail"
                            android:drawablePadding="12dp"
                            android:minHeight="36dp"
                            android:gravity="center_vertical"/>
                        <TextView
                            android:id="@+id/tvProfileEmail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/ui_fragment_profile_tvprofileemail_text_443f1c"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            app:drawableEndCompat="@drawable/ic_ri_arrow_right_s"
                            android:drawablePadding="8dp"/>
                    </LinearLayout>
                    <!-- District row -->
                    <LinearLayout
                        android:id="@+id/btnProfileArea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_fragment_profile_textview_text_c12e4b"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:drawableStartCompat="@drawable/profile_bubble_ic_ri_map_pin"
                            android:drawablePadding="12dp"
                            android:minHeight="36dp"
                            android:gravity="center_vertical"/>
                        <TextView
                            android:id="@+id/tvProfileArea"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/ui_fragment_profile_tvprofilearea_text_443f1c"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            app:drawableEndCompat="@drawable/ic_ri_arrow_right_s"
                            android:drawablePadding="8dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/btnProfileGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_fragment_profile_textview_text_80bbce"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:drawableStartCompat="@drawable/profile_bubble_ic_ri_user_fill"
                            android:drawablePadding="12dp"
                            android:minHeight="36dp"
                            android:gravity="center_vertical"/>
                        <TextView
                            android:id="@+id/tvProfileGender"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/ui_fragment_profile_tvprofilegender_text_443f1c"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            app:drawableEndCompat="@drawable/ic_ri_arrow_right_s"
                            android:drawablePadding="8dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/btnProfileBirthdate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_fragment_profile_textview_text_6f8de3"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:drawableStartCompat="@drawable/profile_bubble_ic_ri_calendar"
                            android:drawablePadding="12dp"
                            android:minHeight="36dp"
                            android:gravity="center_vertical"/>
                        <TextView
                            android:id="@+id/tvProfileBirthdate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/ui_fragment_profile_tvprofilebirthdate_text_443f1c"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            app:drawableEndCompat="@drawable/ic_ri_arrow_right_s"
                            android:drawablePadding="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Tiện ích Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/ui_fragment_profile_textview_text_48403e"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#ECEFF1"
                app:cardBackgroundColor="@color/surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:showDividers="middle"
                    android:divider="@drawable/profile_divider_2"
                    android:dividerPadding="62dp">
                    <!-- Lịch sử đặt sân -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_fragment_profile_textview_text_938f81"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/profile_bubble_ic_ri_calendar"
                        android:drawablePadding="8dp"
                        android:minHeight="36dp"
                        android:gravity="center_vertical"
                        app:drawableEndCompat="@drawable/ic_ri_arrow_right_s"
                        android:id="@+id/btnNavMyBookings"
                        android:padding="14dp"/>
                    <!-- Sân yêu thích -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_fragment_profile_textview_text_9a1921"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/profile_bubble_ic_ri_heart"
                        android:drawablePadding="8dp"
                        android:minHeight="36dp"
                        android:gravity="center_vertical"
                        app:drawableEndCompat="@drawable/ic_ri_arrow_right_s"
                        android:id="@+id/btnNavFavorites"
                        android:padding="14dp"/>
                    <!-- Phương thức thanh toán -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_fragment_profile_textview_text_c216d3"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/profile_bubble_ic_ri_credit_card"
                        android:drawablePadding="8dp"
                        android:minHeight="36dp"
                        android:gravity="center_vertical"
                        app:drawableEndCompat="@drawable/ic_ri_arrow_right_s"
                        android:id="@+id/btnPaymentMethods"
                        android:padding="14dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Cài đặt Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/ui_fragment_profile_textview_text_01f3f3"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#ECEFF1"
                app:cardBackgroundColor="@color/surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:showDividers="middle"
                    android:divider="@drawable/profile_divider_3"
                    android:dividerPadding="62dp">
                    <!-- Thông báo -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_fragment_profile_textview_text_5d6af3"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/profile_bubble_ic_ri_notification"
                        android:drawablePadding="8dp"
                        android:minHeight="36dp"
                        android:gravity="center_vertical"
                        app:drawableEndCompat="@drawable/ic_ri_arrow_right_s"
                        android:id="@+id/btnSettingNotif"
                        android:padding="14dp"/>
                    <!-- Quyền riêng tư -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_fragment_profile_textview_text_99d106"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/profile_bubble_ic_ri_shield"
                        android:drawablePadding="8dp"
                        android:minHeight="36dp"
                        android:gravity="center_vertical"
                        app:drawableEndCompat="@drawable/ic_ri_arrow_right_s"
                        android:id="@+id/btnSettingPrivacy"
                        android:padding="14dp"/>
                    <!-- Trợ giúp -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_fragment_profile_textview_text_4806a7"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/profile_bubble_ic_ri_question"
                        android:drawablePadding="8dp"
                        android:minHeight="36dp"
                        android:gravity="center_vertical"
                        app:drawableEndCompat="@drawable/ic_ri_arrow_right_s"
                        android:id="@+id/btnSettingHelp"
                        android:padding="14dp"/>
                    <!-- Đăng xuất (Red) -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_fragment_profile_textview_text_d513aa"
                        android:textColor="#E53935"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/profile_bubble_ic_ri_logout"
                        android:drawablePadding="8dp"
                        android:minHeight="36dp"
                        android:gravity="center_vertical"
                        app:drawableEndCompat="@drawable/ic_ri_arrow_right_s"
                        android:id="@+id/btnLogout"
                        android:padding="14dp"
                        android:background="@drawable/bg_tag_red_light"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
