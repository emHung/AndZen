<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <!-- Header Banner Gradient/Green -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primary_green"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">
        <!-- Top row: Location & Bell -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_ri_map_pin"
                    app:tint="@color/surface"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/ui_fragment_pitch_list_textview_text_89974f"
                    android:textColor="@color/surface"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_ri_arrow_down"
                    app:tint="@color/surface"
                    android:importantForAccessibility="no"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/btnNotification"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_header_action">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ri_notification"
                    app:tint="@color/surface"
                    android:importantForAccessibility="no"/>
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_red"/>
            </FrameLayout>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ui_fragment_pitch_list_textview_text_bae7c5"
            android:textColor="@color/surface"
            android:textSize="22sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ui_fragment_pitch_list_textview_text_d1375b"
            android:textColor="@color/brand_100"
            android:textSize="13sp"/>
        <!-- Ô tìm kiếm với RemixIcon search -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_rating_badge"
            android:backgroundTint="@color/surface"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_ri_search"
                app:tint="@color/primary_green"
                android:importantForAccessibility="no"/>
            <EditText
                android:id="@+id/etSearchPitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_pitch_hint"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp"
                android:inputType="text"
                android:importantForAutofill="no"/>
            <ImageView
                android:id="@+id/btnOpenFilter"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@drawable/ic_ri_filter"
                app:tint="@color/primary_green"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/ui_action_btnopenfilter_2baa65"/>
        </LinearLayout>
    </LinearLayout>
    <!-- Bộ lọc loại sân (Horizontal Chip Group) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupPitchType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/chip_bg_selector"
                android:textColor="@color/chip_text_selector"
                app:chipStrokeColor="@color/chip_stroke_selector"
                app:chipStrokeWidth="1dp"
                app:chipCornerRadius="20dp"
                android:text="@string/ui_fragment_pitch_list_chipall_text_f7a578"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chipFive"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/chip_bg_selector"
                android:textColor="@color/chip_text_selector"
                app:chipStrokeColor="@color/chip_stroke_selector"
                app:chipStrokeWidth="1dp"
                app:chipCornerRadius="20dp"
                android:text="@string/pitch_type_5"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chipSeven"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/chip_bg_selector"
                android:textColor="@color/chip_text_selector"
                app:chipStrokeColor="@color/chip_stroke_selector"
                app:chipStrokeWidth="1dp"
                app:chipCornerRadius="20dp"
                android:text="@string/pitch_type_7"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chipEleven"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/chip_bg_selector"
                android:textColor="@color/chip_text_selector"
                app:chipStrokeColor="@color/chip_stroke_selector"
                app:chipStrokeWidth="1dp"
                app:chipCornerRadius="20dp"
                android:text="@string/pitch_type_11"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    <!-- Section Title: Sân gần bạn & Xem bản đồ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="6dp">
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="4dp"
            android:background="@drawable/bg_type_badge"
            android:src="@drawable/ic_ri_navigation"
            app:tint="@color/primary_green"
            android:importantForAccessibility="no"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:text="@string/ui_fragment_pitch_list_textview_text_1ec2f9"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_ri_map"
                app:tint="@color/primary_green"
                android:importantForAccessibility="no"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/ui_fragment_pitch_list_textview_text_7dafbf"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary_green"/>
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_ri_arrow_right_s"
                app:tint="@color/primary_green"
                android:importantForAccessibility="no"/>
        </LinearLayout>
    </LinearLayout>
    <!-- Danh sách sân -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPitches"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"/>
        <TextView
            android:id="@+id/tvEmptyPitches"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:text="@string/no_pitches_found"/>
    </FrameLayout>
</LinearLayout>
