<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <!-- Header Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_green"
        app:titleTextColor="@color/surface"
        app:navigationIcon="@drawable/ic_ri_arrow_left"
        app:navigationIconTint="@color/surface"
        app:title="Xác nhận đặt sân"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <!-- Card Tóm tắt đặt chỗ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border"
                app:cardBackgroundColor="@color/surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Ảnh sân bóng -->
                    <ImageView
                        android:id="@+id/ivConfirmBanner"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_pitch_night"
                        android:importantForAccessibility="no"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_activity_booking_confirm_textview_text_541246"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"/>
                        <!-- Tên sân & Badge loại sân -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/tvSummaryPitchName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary_green"
                                android:text=""/>
                            <TextView
                                android:id="@+id/tvSummaryPitchType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_type_badge"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:textColor="@color/primary_green"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:drawablePadding="4dp"
                                app:drawableTint="@color/primary_green"
                                android:text="@string/ui_activity_booking_confirm_tvsummarypitchtype_text_9408bf"
                                app:drawableStartCompat="@drawable/ic_ri_group"/>
                        </LinearLayout>
                        <!-- Địa chỉ -->
                        <TextView
                            android:id="@+id/tvSummaryAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            android:text=""
                            app:drawableStartCompat="@drawable/ic_ri_map_pin_14x14"
                            app:drawableTint="@color/text_muted"
                            android:drawablePadding="6dp"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"/>
                        <!-- Ngày & Giờ -->
                        <TextView
                            android:id="@+id/tvSummaryDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:text="@string/ui_activity_booking_confirm_tvsummarydate_text_c073f1"
                            app:drawableStartCompat="@drawable/ic_ri_calendar_14x14"
                            app:drawableTint="@color/primary_green"
                            android:drawablePadding="6dp"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"/>
                        <TextView
                            android:id="@+id/tvSummaryTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:text="@string/ui_activity_booking_confirm_tvsummarytime_text_de565c"
                            app:drawableStartCompat="@drawable/ic_ri_time_14x14"
                            app:drawableTint="@color/primary_green"
                            android:drawablePadding="6dp"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"/>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="@color/border"/>
                        <!-- Giá sân & Phí dịch vụ -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary"
                                android:text="@string/ui_activity_booking_confirm_textview_text_acd73d"/>
                            <TextView
                                android:id="@+id/tvPitchPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textColor="@color/text_primary"
                                android:text=""/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary"
                                android:text="@string/ui_activity_booking_confirm_textview_text_8ecfc8"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textColor="@color/text_primary"
                                android:text="@string/ui_activity_booking_confirm_textview_text_39c1df"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:text="@string/ui_activity_booking_confirm_textview_text_0b9097"/>
                            <TextView
                                android:id="@+id/tvSummaryTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary_green"
                                android:text=""/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Card Thông tin người đặt -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border"
                app:cardBackgroundColor="@color/surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_activity_booking_confirm_textview_text_282999"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <!-- Họ và tên -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCustomerName"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/ui_activity_booking_confirm_tilcustomername_hint_91ae9d"
                        app:placeholderText="Nhập họ tên của bạn"
                        app:placeholderTextColor="@color/text_muted"
                        app:startIconDrawable="@drawable/ic_ri_user"
                        app:startIconTint="@color/text_muted"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusBottomEnd="10dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCustomerName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:inputType="textPersonName"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <!-- Số điện thoại -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCustomerPhone"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/ui_activity_booking_confirm_tilcustomerphone_hint_7c062c"
                        app:placeholderText="Ví dụ: 0912 345 678"
                        app:placeholderTextColor="@color/text_muted"
                        app:startIconDrawable="@drawable/ic_ri_phone"
                        app:startIconTint="@color/text_muted"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusBottomEnd="10dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCustomerPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:inputType="phone"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/ui_activity_booking_confirm_textview_text_c216d3"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                    <RadioGroup
                        android:id="@+id/rgPaymentMethod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical">
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbPaymentCash"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/ui_activity_booking_confirm_rbpaymentcash_text_b266ad"/>
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbPaymentQr"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_activity_booking_confirm_rbpaymentqr_text_f70d94"/>
                    </RadioGroup>
                    <TextView
                        android:id="@+id/tvPaymentHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/ui_activity_booking_confirm_tvpaymenthint_text_e6ed55"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"/>
                    <!-- Booking information -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/primary_green"
                        android:text="@string/ui_activity_booking_confirm_textview_text_60e04b"
                        app:drawableStartCompat="@drawable/ic_ri_info_16x16"
                        app:drawableTint="@color/primary_green"
                        android:drawablePadding="8dp"
                        android:layout_marginTop="14dp"
                        android:padding="12dp"
                        android:gravity="center_vertical"/>
                    <!-- Checkbox xác nhận -->
                    <CheckBox
                        android:id="@+id/cbConfirmTerms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:button="@drawable/sl_ri_checkbox"
                        android:paddingStart="6dp"
                        android:checked="true"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:text="@string/ui_activity_booking_confirm_cbconfirmterms_text_c1adad"
                        android:paddingEnd="6dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
    <!-- Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:text="@string/ui_activity_booking_confirm_textview_text_0a622e"/>
            <TextView
                android:id="@+id/tvBottomTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary_green"
                android:text=""/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:text="@string/ui_activity_booking_confirm_textview_text_7a270b"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitBooking"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="@string/ui_activity_booking_confirm_btnsubmitbooking_text_02d0ee"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/primary_green"
            android:textColor="@color/surface"
            app:icon="@drawable/ic_ri_arrow_right"
            app:iconGravity="end"
            app:iconTint="@color/surface"/>
    </LinearLayout>
</LinearLayout>
