<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SanBong" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/brand_700</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorPrimaryContainer">@color/brand_100</item>
        <item name="colorOnPrimaryContainer">@color/brand_950</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/brand_600</item>
        <item name="colorOnSecondary">@color/surface</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/brand_50</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/brand_800</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Dialogs -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.SanBong.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.SanBong.MaterialAlertDialog</item>
    </style>

    <style name="ThemeOverlay.SanBong.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <style name="ThemeOverlay.SanBong.DatePicker" parent="Theme.Material3.Light.Dialog">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorSecondary">@color/primary_green</item>
        <item name="colorAccent">@color/primary_green</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorAccent">@color/primary_green</item>
        <item name="android:colorPrimary">@color/primary_green</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:headerBackground">@color/primary_green</item>
        <item name="android:datePickerStyle">@style/Widget.SanBong.DatePicker</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.SanBong.DatePicker.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.SanBong.DatePicker.Button</item>
    </style>

    <style name="Widget.SanBong.DatePicker.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary_green</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.SanBong.DatePicker" parent="android:Widget.Material.Light.DatePicker">
        <item name="android:headerBackground">@color/primary_green</item>
        <item name="android:yearListSelectorColor">@color/primary_green</item>
        <item name="android:calendarTextColor">@color/text_primary</item>
        <item name="android:dayOfWeekTextAppearance">@style/TextAppearance.SanBong.DatePicker.DayOfWeek</item>
    </style>

    <style name="TextAppearance.SanBong.DatePicker.DayOfWeek" parent="android:TextAppearance.Material.Caption">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
